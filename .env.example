# ComplaintIQ Environment Configuration

PROJECT_NAME=ComplaintIQ
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
PORT=8000

# MongoDB Configuration
# Real MongoDB connection string; if unavailable locally and USE_MOCK_DB_IF_UNAVAILABLE is true,
# ComplaintIQ will seamlessly fall back to an in-memory mongomock datastore with zero crashes.
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=complaintiq
USE_MOCK_DB_IF_UNAVAILABLE=True

# Redis Cache / Background Workers
REDIS_URL=redis://localhost:6379/0
